{
  "name": "uptime-kuma-api-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Private REST/MCP API to provision and synchronize Uptime Kuma monitors from an external system.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@t3-oss/env-core": "^0.13.11",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
