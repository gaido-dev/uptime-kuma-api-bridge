PORT=3050
HOST=0.0.0.0
LOG_LEVEL=info

# Static bearer token external tools must send as `Authorization: Bearer <token>`.
# Independent of Uptime Kuma's own accounts/API keys. Generate with e.g. `openssl rand -hex 32`.
BRIDGE_AUTH_TOKEN=change-me

# Credentials of a dedicated Uptime Kuma account the bridge uses to drive monitors via
# socket.io. Must have 2FA disabled. This account must own every monitor/group the bridge
# needs to manage (Uptime Kuma scopes monitors by owner) — a single-admin instance already
# satisfies this since that account owns everything.
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_SERVICE_USERNAME=admin
UPTIME_KUMA_SERVICE_PASSWORD=change-me
UPTIME_KUMA_SOCKET_TIMEOUT_MS=10000
UPTIME_KUMA_ACK_TIMEOUT_MS=10000
